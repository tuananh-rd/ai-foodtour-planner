                    "text_contains": ["chưa có dữ liệu thời tiết"], "state_absent": ["profile.duration_min.value"]}},
        {"action": {"type": "set_location", "location": {"district": "Cầu Giấy"}},
         "expect": {"understanding": "action", "tour": "none", "llm_calls_max": 0, "blocks_include": ["dish_suggestions"],
