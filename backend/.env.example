# Copy to backend/.env (git-ignored). Never commit real keys. Process environment overrides this file.
# --- LLM (Gemini) ---
# FOODTOUR_LLM=gemini            # mock (default) | gemini | off
# GEMINI_API_KEY=                # server-side only
# FOODTOUR_GEMINI_MODEL=gemini-3.5-flash-lite
# FOODTOUR_EXPLAIN=gemini        # template (default) | gemini (checked, falls back to template)
# FOODTOUR_LLM_DAILY_BUDGET=18   # existing default; Pacific-midnight daily window, do not enlarge without approval
# FOODTOUR_BUDGET_DB=            # absolute local SQLite ledger; preserve existing ledger across restarts
# --- Optional approved web lookup (disabled until configured locally) ---
# TAVILY_API_KEY=                # server only; configure in backend/.env, never in chat/frontend/Git
# FOODTOUR_TAVILY_ENABLED=0      # set1 only for an existing configured free account
# FOODTOUR_TAVILY_FREE_ONLY=0    # operator attests no pay-as-you-go/billing enabled and accounts for shared key usage
# FOODTOUR_TAVILY_BUDGET_DB=      # required absolute persistent local SQLite path; parent directory must exist
# FOODTOUR_TAVILY_DAILY_CREDITS=20
# FOODTOUR_TAVILY_MONTHLY_CREDITS=500 # local UTC guards; max900, not a guarantee of account allowance
# --- Walking routing ---
# FOODTOUR_ROUTING=ors           # estimate (default) | ors | osrm
# ORS_API_KEY=                   # openrouteservice key (free plan requires sign-up by you)
# FOODTOUR_ROUTING_ENDPOINT=     # osrm only, e.g. a self-hosted OSRM foot server base URL
# FOODTOUR_PROVIDER_HOSTS=       # extra HTTPS hosts allowed for providers (comma-separated, exact)
# FOODTOUR_ROUTING_DAILY_BUDGET=400
# --- Data / sessions ---
# FOODTOUR_DATA_PATH=            # absolute path to private CSV/JSON (never commit)
# FOODTOUR_EVIDENCE_PATH=        # absolute path to verified evidence overlay JSON
# FOODTOUR_SESSION_DB=           # absolute path to SQLite file for persistent sessions
# WEB_ORIGIN=http://localhost:3000
# --- Google Maps Platform (separate restricted browser and server keys) ---
# GOOGLE_MAPS_BROWSER_KEY=       # Websites + Maps JavaScript / Places API (New) restrictions
# GOOGLE_MAPS_MAP_ID=            # map ID; DEMO_MAP_ID permitted for local development
# GOOGLE_MAPS_SERVER_KEY=        # server only; Routes API + Geocoding API restrictions
# FOODTOUR_ROUTING=google       # explicit opt-in; no key => labelled unavailable
# FOODTOUR_GEOCODER=google      # server-side manual address / origin_text geocoding
# FOODTOUR_GEOCODE_DAILY_BUDGET=100
