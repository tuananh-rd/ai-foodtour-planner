# Copy to backend/.env (git-ignored). Never commit real keys. Process environment overrides this file.
# --- LLM (Gemini) ---
# FOODTOUR_LLM=gemini            # mock (default) | gemini | off
# GEMINI_API_KEY=                # server-side only
# FOODTOUR_GEMINI_MODEL=gemini-3.5-flash-lite
# FOODTOUR_EXPLAIN=gemini        # template (default) | gemini (checked, falls back to template)
# FOODTOUR_LLM_DAILY_BUDGET=200  # max Gemini calls per process per UTC day
# --- Walking routing ---
# FOODTOUR_ROUTING=ors           # estimate (default) | ors | osrm
# ORS_API_KEY=                   # openrouteservice key (free plan requires sign-up by you)
# FOODTOUR_ROUTING_ENDPOINT=     # osrm only, e.g. a self-hosted OSRM foot server base URL
# FOODTOUR_PROVIDER_HOSTS=       # extra HTTPS hosts allowed for providers (comma-separated, exact)
# FOODTOUR_ROUTING_DAILY_BUDGET=400
# --- Data / sessions ---
# FOODTOUR_DATA_PATH=            # absolute path to private CSV/JSON (never commit)
# FOODTOUR_EVIDENCE_PATH=        # absolute path to verified evidence overlay JSON
# FOODTOUR_SESSION_DB=           # absolute path to SQLite file for persistent sessions
# WEB_ORIGIN=http://localhost:3000
